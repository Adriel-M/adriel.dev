{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "lint": {
      "dependsOn": ["@adrieldev/eslint-configs#build"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["@adrieldev/eslint-configs#build"]
    },
    "format": {},
    "format:fix": {
      "cache": false
    },
    "test": {},
    "check": {}
  },
  "globalDependencies": ["pnpm-lock.yaml", "prettier.config.ts", "eslint.config.ts"],
  "remoteCache": {
    "signature": true
  }
}
